{
  "name": "wordgard-devtools-panel",
  "version": "0.0.0",
  "description": "Wordgard DevTools panel: React UI, transport-agnostic, mountable in-page",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./transport": {
      "source": "./src/transport.ts",
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "imports": {
    "#components/*": "./src/components/*.tsx"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wordgard-devtools": "0.0.0"
  },
  "devDependencies": {
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.23.0",
    "wordgard": "file:../../../wordgard"
  }
}
