{
  "name": "@stesura/wordgard-dev-tools-panel",
  "version": "0.1.1",
  "description": "Wordgard DevTools panel: React UI, transport-agnostic, mountable in-page",
  "keywords": [
    "wordgard",
    "devtools",
    "rich-text",
    "editor",
    "debugging"
  ],
  "homepage": "https://github.com/stesura/wordgard-dev-tools#readme",
  "bugs": {
    "url": "https://github.com/stesura/wordgard-dev-tools/issues"
  },
  "author": "Edoardo Caratti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stesura/wordgard-dev-tools.git",
    "directory": "packages/panel"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "source": "./src/ui.ts"
    },
    "./transport": {
      "source": "./src/transport.ts",
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*",
    "#icons": "./src/icons/index.ts",
    "#lib/*": "./src/lib/*",
    "#stores/*": "./src/stores/*"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@stesura/wordgard-dev-tools": "0.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@nanostores/react": "^2.0.1",
    "@stesura/wordgard-dev-tools": "0.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "heroicons": "^2.2.0",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.18.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "wordgard": "file:../../../wordgard"
  }
}
