{
  "name": "wordgard-devtools-extension",
  "description": "Wordgard DevTools for Chrome and Firefox",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "e2e": "wxt build && npm run build -w demo && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wordgard-devtools": "0.0.0",
    "wordgard-devtools-panel": "0.0.0"
  },
  "devDependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "wxt": "^0.21.5"
  }
}
