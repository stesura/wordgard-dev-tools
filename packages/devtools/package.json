{
  "name": "@stesura/wordgard-dev-tools",
  "version": "0.0.0",
  "description": "Page side of Wordgard DevTools: the editor registry and the agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stesura/wordgard-devtools.git",
    "directory": "packages/devtools"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "wordgard": ">=0.6.2 <1"
  },
  "devDependencies": {
    "wordgard": "file:../../../wordgard"
  }
}
