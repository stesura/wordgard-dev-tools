{
  "name": "wordgard-devtools-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/devtools",
    "packages/panel",
    "packages/extension",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dependency-check": "depcruise packages demo scripts",
    "compiler:check": "node scripts/compiler-check.ts",
    "check": "npm run release:check && npm run format:check && npm run dependency-check && npm run readme:check && npm run typecheck && npm run lint",
    "release:version": "node scripts/version.ts",
    "release:check": "node scripts/version.ts --check",
    "release:prepare": "node scripts/release.ts prepare",
    "release:publish": "node scripts/release.ts publish",
    "readme": "node scripts/readme.ts",
    "readme:check": "node scripts/readme.ts --check",
    "screenshots": "node scripts/screenshots.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
