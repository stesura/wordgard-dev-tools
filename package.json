{
  "name": "wordgard-devtools-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/devtools",
    "packages/panel",
    "packages/extension",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
